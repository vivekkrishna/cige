{
  "name": "e2e-cige",
  "version": "0.3.0",
  "description": "CIGE agentic test cases (Context, Intent, Guardrails, Execution) as portable JSON, run on e2e, Vibium, Playwright Test, or any runner adapter, with run summaries, replay, and field-rule checks for self-healing agents",
  "keywords": [
    "e2e",
    "vibium",
    "playwright",
    "playwright-test",
    "end-to-end",
    "testing",
    "agentic-testing",
    "cige",
    "self-healing-tests",
    "guardrails"
  ],
  "license": "Apache-2.0",
  "author": "Vivek Krishna Choppa <vivekkrishnachoppa@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivekkrishna/cige.git"
  },
  "bugs": {
    "url": "https://github.com/vivekkrishna/cige/issues"
  },
  "homepage": "https://github.com/vivekkrishna/cige#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "default": "./dist/runner/index.js"
    },
    "./e2e": {
      "types": "./dist/adapters/e2e/index.d.ts",
      "default": "./dist/adapters/e2e/index.js"
    },
    "./vibium": {
      "types": "./dist/adapters/vibium/index.d.ts",
      "default": "./dist/adapters/vibium/index.js"
    },
    "./playwright": {
      "types": "./dist/adapters/playwright/index.d.ts",
      "default": "./dist/adapters/playwright/index.js"
    },
    "./playwright/reporter": {
      "types": "./dist/adapters/playwright/reporter.d.ts",
      "default": "./dist/adapters/playwright/reporter.js"
    },
    "./schema/cige-1.schema.json": "./schema/cige-1.schema.json"
  },
  "bin": {
    "cige": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "schema/cige-1.schema.json",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && node scripts/build-schema.ts && tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "oxc-parser": "0.155.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.56.0 <2",
    "e2e": ">=0.21.0 <1",
    "vibium": ">=26.11.16"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "e2e": {
      "optional": true
    },
    "vibium": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.96",
    "@e2e-dev/web": "0.16.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.5",
    "ai": "7.0.162",
    "ajv": "8.20.0",
    "e2e": "0.23.1",
    "typescript": "7.0.2",
    "vibium": "26.11.16",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  }
}
