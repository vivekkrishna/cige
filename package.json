{
  "name": "cige",
  "version": "0.1.0",
  "description": "CIGE test cases for e2e: Context, Intent, Guardrails, and Execution as portable JSON, with run summaries, replay, and field-rule checks for self-healing agents",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "agentic-testing",
    "cige",
    "self-healing-tests",
    "guardrails"
  ],
  "license": "Apache-2.0",
  "author": "Vivek Krishna Choppa <vivekkrishnachoppa@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivekkrishna/cige.git"
  },
  "bugs": {
    "url": "https://github.com/vivekkrishna/cige/issues"
  },
  "homepage": "https://github.com/vivekkrishna/cige#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/cige-1.schema.json": "./schema/cige-1.schema.json"
  },
  "bin": {
    "cige": "./dist/bin.js"
  },
  "files": [
    "dist",
    "schema/cige-1.schema.json",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && node scripts/build-schema.ts && tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "oxc-parser": "0.155.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "e2e": ">=0.21.0 <1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "e2e": "0.21.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  }
}
